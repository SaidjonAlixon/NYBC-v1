# Database (API server + migrations)
DATABASE_URL=postgresql://user:password@host:port/database

# Local dev — frontend (Vite)
PORT=5173
BASE_PATH=/

# Local dev — API proxy target (Vite → Express)
VITE_API_PROXY=http://127.0.0.1:8080

# Production (Vercel) — public API URL (Railway, Render, etc.)
# Example: https://your-api.up.railway.app
VITE_API_URL=
