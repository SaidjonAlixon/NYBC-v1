{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "packageManager": "pnpm@9.15.9",
  "type": "module",
  "scripts": {
    "preinstall": "node -e \"const ua=process.env.npm_config_user_agent||'';if(process.env.VERCEL||process.env.CI||ua.includes('pnpm'))process.exit(0);console.error('Use pnpm instead of npm/yarn');process.exit(1)\"",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck",
    "db:push": "dotenv -e .env -- pnpm --filter @workspace/db run push",
    "dev": "dotenv -e .env -- pnpm --filter @workspace/truck-logistics run dev",
    "dev:web": "dotenv -e .env -- pnpm --filter @workspace/truck-logistics run dev",
    "dev:api": "tsx server.ts"
  },
  "private": true,
  "dependencies": {
    "@vercel/blob": "^0.27.3",
    "express": "^4.21.2",
    "busboy": "^1.6.0",
    "multer": "^1.4.5-lts.2",
    "serverless-http": "^3.2.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/busboy": "^1.5.4",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.13.4",
    "cross-env": "^7.0.3",
    "dotenv": "^16.6.1",
    "dotenv-cli": "^8.0.0",
    "prettier": "^3.8.3",
    "tsx": "^4.19.3",
    "typescript": "~5.9.3"
  }
}
