# Database (legacy API server + migrations)
DATABASE_URL=postgresql://user:password@host:port/database

# Local dev — frontend (Vite)
PORT=5173
BASE_PATH=/

# Local dev — API server (Express)
API_PORT=4000

# Local dev — API proxy target (Vite → Express)
VITE_API_PROXY=http://127.0.0.1:4000

# Production (Vercel) — leave empty to use same-origin /api routes
VITE_API_URL=

# Vercel Blob Storage (Vercel dashboard → Storage → Blob → Quickstart)
BLOB_STORE_ID=
BLOB_READ_WRITE_TOKEN=

# Telegram notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
