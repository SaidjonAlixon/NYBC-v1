{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "preinstall": "node -e \"const ua=process.env.npm_config_user_agent||'';if(process.env.VERCEL||process.env.CI||ua.includes('pnpm'))process.exit(0);console.error('Use pnpm instead of npm/yarn');process.exit(1)\""
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck",
    "db:push": "dotenv -e .env -- pnpm --filter @workspace/db run push",
    "dev:web": "dotenv -e .env -- pnpm --filter @workspace/truck-logistics run dev",
    "dev:api": "dotenv -e .env -- cross-env PORT=8080 pnpm --filter @workspace/api-server run dev"
  },
  "private": true,
  "devDependencies": {
    "cross-env": "^7.0.3",
    "dotenv": "^16.6.1",
    "dotenv-cli": "^8.0.0",
    "prettier": "^3.8.3",
    "typescript": "~5.9.3"
  }
}
